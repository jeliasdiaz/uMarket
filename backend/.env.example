# Copia este archivo a backend/.env. El .env real NUNCA se commitea.

ENTORNO=local

# Postgres local (compose.yaml). En Neon: la cadena *pooled* (-pooler) aqui y la
# directa en DATABASE_URL_DIRECTA (para Alembic). Neon entrega postgresql://...;
# config.py agrega el driver solo.
DATABASE_URL=postgresql+psycopg://umarket:umarket@localhost:5433/umarket
DATABASE_URL_DIRECTA=

# Busqueda: "palabras" (baseline, por defecto), "intencion" (Gemini con respaldo) o "ab".
BUSQUEDA_INTERPRETE=palabras
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# https://aistudio.google.com/apikey  -  tier PAGADO antes del primer usuario real (D-12).
GEMINI_API_KEY=
LLM_PRESUPUESTO_DIARIO_USD=1.0

# Acceso. En produccion: secreto propio de 32+ caracteres y COOKIE_SEGURA=true.
SECRETO_SERVIDOR=solo-para-desarrollo-cambiar
# Solo local/test: codigo de acceso conocido para probar sin correo. Prohibido en produccion.
CODIGO_ACCESO_FIJO=123456
COOKIE_SEGURA=false
ORIGENES_PERMITIDOS=["http://localhost:3000"]

# Avisos push (opcional). Generar con: npx web-push generate-vapid-keys
VAPID_CLAVE_PUBLICA=
VAPID_CLAVE_PRIVADA=
VAPID_CONTACTO=mailto:equipo@umarket.local
